6. Database Requirements
Database
PostgreSQL
ORM (Optional)
Prisma / Sequelize

Main Tables
Users Table
CREATE TABLE users (  id SERIAL PRIMARY KEY,  name VARCHAR(100),  email VARCHAR(100) UNIQUE,  password TEXT,  role VARCHAR(20),  phone VARCHAR(15),  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP);

Loan Applications Table
CREATE TABLE loan_applications (  id SERIAL PRIMARY KEY,  user_id INTEGER REFERENCES users(id),  loan_amount NUMERIC,  interest_rate NUMERIC,  tenure_months INTEGER,  status VARCHAR(30),  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP);

Documents Table
CREATE TABLE documents (  id SERIAL PRIMARY KEY,  loan_id INTEGER REFERENCES loan_applications(id),  document_type VARCHAR(50),  file_url TEXT);

EMI Schedule Table
CREATE TABLE emi_schedules (  id SERIAL PRIMARY KEY,  loan_id INTEGER REFERENCES loan_applications(id),  due_date DATE,  emi_amount NUMERIC,  payment_status VARCHAR(20));

Payments Table
CREATE TABLE payments (  id SERIAL PRIMARY KEY,  loan_id INTEGER REFERENCES loan_applications(id),  stripe_payment_id TEXT,  amount NUMERIC,  payment_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP);

